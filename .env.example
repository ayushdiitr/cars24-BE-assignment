PORT=5000
DATABASE_URL=postgresql://cars24:cars24@localhost:5432/cars24

# Required only for POST /api/query. Every other endpoint works without it.
ANTHROPIC_API_KEY=
# Optional: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
# OPENAI_API_KEY=

# Optional tuning
# PAID_NOT_SCHEDULED_GRACE_DAYS=3
# AGENT_MAX_ITERATIONS=8
# TOOL_CACHE_TTL_MS=30000
# RATE_LIMIT_BURST=10
# RATE_LIMIT_PER_MINUTE=20

# Optional USD pricing per one million tokens. Set provider-wide values or
# model-specific values such as ANTHROPIC_CLAUDE_OPUS_5_INPUT_USD_PER_MILLION.
# Costs remain null until the relevant input/output rates are configured.
# ANTHROPIC_INPUT_USD_PER_MILLION=
# ANTHROPIC_OUTPUT_USD_PER_MILLION=
# ANTHROPIC_CACHE_READ_USD_PER_MILLION=
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# OPENAI_CACHE_READ_USD_PER_MILLION=
